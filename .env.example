# Copy to .env and fill in. Bun loads .env automatically, no dotenv package needed.
# See BUILD_PLAN.md section "Secrets & config" for what each key gates and its cost model.

# --- LLM (script, title/thumbnail concepts, provenance lint prompts) ---
ANTHROPIC_API_KEY=
# Optional fallback / cost-comparison model
OPENAI_API_KEY=

# --- Jev / TypeSafe AI (Score / Choice / Noul gates only — never generation) ---
JEV_API_KEY=

# --- Voice (see BUILD_PLAN.md 5.4) ---
# voicebox (default, $0 marginal cost, self-hosted Chatterbox) | azure | elevenlabs
VOICE_PROVIDER=voicebox
# Self-hosted Voicebox server (github.com/jamiepine/voicebox, MIT). No API
# key -- it's your own infra. Provision it (Docker Compose) on the render
# box; not needed at all if VOICE_PROVIDER=azure or elevenlabs.
VOICEBOX_BASE_URL=http://127.0.0.1:17493
# Fallback: native word-level timestamps, no self-hosting required
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional upgrade only ($0.45-0.90/video): eleven_v3 audio-tag expressiveness
ELEVENLABS_API_KEY=

# --- SFX ---
FREESOUND_API_KEY=

# --- Stock B-roll ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- AI stills (thumbnails, metaphor frames — never photoreal fake B-roll by default) ---
FAL_KEY=

# --- Music (v1 = YouTube Audio Library, manually downloaded into assets/music/ + ledger.json;
#     no API key needed for v1. v2 = Epidemic Sound Partner API once a partnership is signed.) ---
EPIDEMIC_SOUND_PARTNER_KEY=

# --- Orchestration ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Publish ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Storage ---
# Content-addressed artifact store root. Local disk for v1; swap for S3-compatible
# object storage (R2/S3) once rendering moves off a single box.
ARTIFACT_STORE_ROOT=./artifacts

# --- Postgres (state store: videoId, step, inputHash, outputUri, costCents) ---
DATABASE_URL=
